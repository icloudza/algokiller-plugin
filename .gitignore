# Local environment and secrets
.env
.env.*
!.env.example

# Virtualenvs and Python caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE/editor local state
.idea/
.vscode/

# Build and packaging output
dist/
build/
*.egg-info/

.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride

# Editor swap / backup
*.swp
*.swo
*~
.*.sw?
*.bak
*.orig

# AlgoKiller runtime test fixtures (if you drop traces into the repo for testing)
captures/
traces/
artifacts/
*.trace.log

# AlgoKiller analysis outputs — bind_trace's project-marker walk-up writes
# reports into <project>/.algokiller/ by default (5-priority resolution).
# Test fixtures live under tools/search/tests/fixtures/, so running the
# e2e suite from this repo can land artifacts at tools/search/.algokiller/.
# These are per-run / per-developer outputs and should never be committed.
.algokiller/

# Local Python tooling state
.python-version
*.egg
.eggs/

# ak_search build artifact in source dir (server/bin/ak_search is the
# canonical runtime binary; tools/search/ak_search is a transient `make` output)
tools/search/ak_search
